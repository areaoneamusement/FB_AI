{
  "name": "fb-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "vite build",
    "dev:dashboard": "vite",
    "typecheck": "tsc --noEmit",
