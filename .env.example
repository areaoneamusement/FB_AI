# FB_AI — biến môi trường cho lần chạy thật (Phase 1).
# Copy sang .env rồi điền. KHÔNG commit file .env.

# --- Bắt buộc ---------------------------------------------------------------

# Mật khẩu vào bảng duyệt. Tối thiểu 16 ký tự.
# Sinh nhanh: openssl rand -hex 24
FB_AI_OPERATOR_TOKEN=

# Model A — sinh nội dung. https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Model B — kiểm chứng chéo. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Tuỳ chọn ---------------------------------------------------------------

# Mặc định: claude-opus-5
ANTHROPIC_MODEL=

# Mặc định: gemini-3.1-flash-lite — tầng mà key free tier thực sự dùng được.
# Đổi thành model mà API key của bạn thực sự truy cập được; `npm run doctor` sẽ nói rõ.
GEMINI_MODEL=

# Nâng giới hạn GitHub search từ 10 lên 30 request/phút. Chỉ cần quyền public_repo.
GITHUB_TOKEN=

# Ký CSRF token. Bỏ trống thì mỗi lần khởi động sinh mới (đăng nhập lại sau restart).
FB_AI_CSRF_SECRET=

# Đường dẫn — mặc định như dưới đây.
FB_AI_CONFIG=config/fb-ai.config.json
FB_AI_DB=data/fb-ai.sqlite
FB_AI_STATIC_DIR=dist/dashboard

# Máy chủ. Mặc định chỉ nghe localhost — đừng đổi thành 0.0.0.0 khi chưa có HTTPS
# và reverse proxy, vì operator token sẽ đi qua mạng ở dạng thô.
FB_AI_HOST=127.0.0.1
FB_AI_PORT=4173

# User-Agent gửi tới các nguồn. Nên ghi cách liên hệ để chủ trang biết ai đang đọc.
FB_AI_USER_AGENT=
